{
  "name": "battlechan-solana",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build:program": "anchor build",
    "deploy:testnet": "bash scripts/deploy-testnet.sh",
    "init:testnet": "ANCHOR_PROVIDER_URL=https://api.testnet.solana.com ANCHOR_WALLET=${ANCHOR_WALLET:-$HOME/.config/solana/id.json} ts-node scripts/init.ts",
    "test": "anchor test",
    "app:dev": "cd app && npm run dev",
    "app:build": "cd app && npm run build"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.31.1",
    "@solana/spl-token": "^0.4.9",
    "@solana/web3.js": "^1.98.0"
  },
  "devDependencies": {
    "@types/bn.js": "^5.1.0",
    "@types/chai": "^4.3.0",
    "@types/mocha": "^10.0.0",
    "chai": "^4.3.4",
    "mocha": "^10.0.0",
    "ts-mocha": "^10.0.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.5.4"
  }
}
